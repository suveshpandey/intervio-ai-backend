// Intervio schema. Tables are added per build phase.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  email
  google
}

enum ParseStatus {
  pending
  processing
  done
  failed
}

enum ClaimStatus {
  pending
  selected
  verified
  partial
  insufficient
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  authProvider AuthProvider @map("auth_provider")
  passwordHash String?      @map("password_hash")
  name         String?
  avatarUrl    String?      @map("avatar_url")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  resumes         Resume[]
  jobDescriptions JobDescription[]
  blueprints      Blueprint[]
  interviews      Interview[]

  @@map("users")
}

model Resume {
  id     String @id @default(uuid())
  userId String @map("user_id")

  fileUrl     String      @map("file_url") // S3 object key
  fileName    String      @map("file_name")
  fileHash    String      @map("file_hash") // sha256, for dedupe + caching extraction
  parseStatus ParseStatus @default(pending) @map("parse_status")
  parseError  String?     @map("parse_error")

  // { skills: [...], projects: [...], experience: [...] }
  extracted Json?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  claims     Claim[]
  blueprints Blueprint[]

  @@index([userId])
  @@map("resumes")
}

model JobDescription {
  id     String @id @default(uuid())
  userId String @map("user_id")

  rawText        String @map("raw_text")
  requiredSkills Json   @default("[]") @map("required_skills") // string[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("job_descriptions")
}

model Claim {
  id       String @id @default(uuid())
  resumeId String @map("resume_id")

  text          String
  category      String // e.g. scale, impact, ownership, tech-depth
  relatedSkills String[] @map("related_skills")
  importance    Int      @default(3) // 1–5: how central to the resume
  priority      Int      @default(3) // 1–5: how worth probing
  status        ClaimStatus @default(pending)
  confidence    Float? // set after the interview

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  resume   Resume     @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  evidence Evidence[]

  @@index([resumeId])
  @@map("claims")
}

/// A live (or finished) interview session. The plan lives on the Blueprint;
/// this row is the session: status + timing. Durable turn-by-turn state is in
/// Redis and checkpointed here via `turns`.
model Interview {
  id          String @id @default(uuid())
  userId      String @map("user_id")
  blueprintId String @map("blueprint_id")

  status    String    @default("planned") // planned | live | completed | abandoned
  startedAt DateTime? @map("started_at")
  endedAt   DateTime? @map("ended_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  blueprint Blueprint  @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  turns     Turn[]
  evidence  Evidence[]

  @@index([userId])
  @@index([blueprintId])
  @@map("interviews")
}

/// One question/answer exchange. `eval` holds the LLM's structured judgement;
/// `chosenAction` is what OUR engine actually decided (may differ from the suggestion).
model Turn {
  id          String @id @default(uuid())
  interviewId String @map("interview_id")

  idx          Int
  sectionKey   String  @map("section_key")
  objective    String
  questionText String  @map("question_text")
  claimId      String? @map("claim_id") // the claim being probed, when applicable

  answerTranscript String? @map("answer_transcript")
  eval             Json? // { answerQuality, technicalDepth, claimEvidence, issue, reason, ... }
  chosenAction     String? @map("chosen_action")

  askedAt    DateTime  @default(now()) @map("asked_at")
  answeredAt DateTime? @map("answered_at")

  interview Interview  @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  evidence  Evidence[]

  @@unique([interviewId, idx])
  @@index([interviewId])
  @@map("turns")
}

/// Support/weaken signal for a claim, written as the interview runs.
/// The final claim audit (Phase 5) aggregates these.
model Evidence {
  id          String @id @default(uuid())
  interviewId String @map("interview_id")
  claimId     String @map("claim_id")
  turnId      String @map("turn_id")

  polarity  String // support | weaken
  weight    Float // 0–1
  rationale String

  createdAt DateTime @default(now()) @map("created_at")

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  claim     Claim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  turn      Turn      @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@index([interviewId])
  @@index([claimId])
  @@map("evidence")
}

/// The interview plan: config + ordered sections + which claims to probe.
/// Built once (Phase 2) so the live engine never needs the raw resume/JD.
model Blueprint {
  id       String  @id @default(uuid())
  userId   String  @map("user_id")
  resumeId String  @map("resume_id")
  jdId     String? @map("jd_id")

  role        String
  level       String // junior | mid | senior
  difficulty  String // easy | standard | hard
  durationMin Int    @map("duration_min")

  sections      Json     // ordered [{ key, title, budgetMin }]
  probeClaimIds String[] @map("probe_claim_ids") // ordered claim ids to challenge

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume     Resume      @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  interviews Interview[]

  @@index([userId])
  @@index([resumeId])
  @@map("blueprints")
}
