# ── Runtime ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (the frontend).
CORS_ORIGIN=http://localhost:3000

# ── Datastores ───────────────────────────────────────────
DATABASE_URL=postgresql://intervio:intervio@localhost:5432/intervio?schema=public
REDIS_URL=redis://localhost:6379

# ── Auth / JWT ───────────────────────────────────────────
# Use long random strings (openssl rand -base64 48). Keep access/refresh secrets different.
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Cookie domain/security. In prod set COOKIE_SECURE=true and a real domain.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ── Google OAuth ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
# Where to send the browser after a successful Google login.
OAUTH_SUCCESS_REDIRECT=http://localhost:3000/dashboard

# ── Object storage (AWS S3) ──────────────────────────────
# IAM user scoped to the bucket (Get/Put/DeleteObject only). Not root keys.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=intervio-resumes

# ── LLM (euri-gateway, OpenAI-compatible) ────────────────
# Routes to Gemini (primary) + DeepSeek (fallback). No OpenAI models used.
EURI_API_KEY=
EURI_BASE_URL=https://api.euron.one/api/v1/euri
